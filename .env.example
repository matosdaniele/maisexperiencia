# Copie para .env e preencha. Nunca commitar o ficheiro .env.

MONGODB_URI="mongodb+srv://<USER>:<PASSWORD>@<CLUSTER>.mongodb.net/maisexperiencia?retryWrites=true&w=majority"
PORT=3000
HOST=127.0.0.1

# E-mail transacional (Gmail — ver file/email-dominio-gmail.md)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=seu@gmail.com
SMTP_PASS=senha_de_app_gmail
MAIL_FROM_NAME=Mais Experiência
MAIL_FROM_EMAIL=contato@maisexperiencia.com.br
SITE_URL=https://maisexperiencia.com.br

# Admin marketplace (piloto manual)
ADMIN_API_KEY=defina_uma_chave_secreta_longa
ADMIN_NOTIFY_EMAIL=contato@maisexperiencia.com.br
MARKETPLACE_COMISSAO_PCT=20

# Alinhamento currículo × vaga (OpenRouter — https://openrouter.ai/keys)
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openrouter/free
# OPENROUTER_MODEL=google/gemini-2.5-flash
